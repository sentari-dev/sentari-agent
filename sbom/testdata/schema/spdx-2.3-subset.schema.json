{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sentari.io/schema/spdx-2.3-subset.json",
  "title": "SPDX 2.3 hermetic subset (sentari-agent SBOM output)",
  "description": "A self-contained, air-gap-safe subset of the SPDX 2.3 JSON Schema. The upstream SPDX schema resolves external $ref meta-schemas that cannot be fetched offline under the CGO_ENABLED=0 / air-gap charter, so this schema inlines no external refs. It asserts the STRUCTURE the agent actually emits (see sbom/spdx.go): the required document fields and the shape of every package and relationship. additionalProperties is permitted so a future field addition is caught by the golden byte-compare, not by this structural gate.",
  "type": "object",
  "required": [
    "SPDXID",
    "spdxVersion",
    "creationInfo",
    "name",
    "dataLicense",
    "documentNamespace",
    "packages"
  ],
  "properties": {
    "SPDXID": { "const": "SPDXRef-DOCUMENT" },
    "spdxVersion": { "const": "SPDX-2.3" },
    "dataLicense": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "documentNamespace": { "type": "string", "pattern": "^https://" },
    "creationInfo": {
      "type": "object",
      "required": ["created", "creators"],
      "properties": {
        "created": { "type": "string", "minLength": 1 },
        "creators": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["SPDXID", "name", "downloadLocation", "copyrightText"],
        "properties": {
          "SPDXID": { "type": "string", "pattern": "^SPDXRef-" },
          "name": { "type": "string", "minLength": 1 },
          "versionInfo": { "type": "string" },
          "downloadLocation": { "type": "string", "minLength": 1 },
          "filesAnalyzed": { "type": "boolean" },
          "licenseConcluded": { "type": "string" },
          "licenseDeclared": { "type": "string" },
          "copyrightText": { "type": "string", "minLength": 1 },
          "externalRefs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["referenceCategory", "referenceType", "referenceLocator"],
              "properties": {
                "referenceCategory": { "type": "string" },
                "referenceType": { "type": "string" },
                "referenceLocator": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["spdxElementId", "relationshipType", "relatedSpdxElement"],
        "properties": {
          "spdxElementId": { "type": "string", "minLength": 1 },
          "relationshipType": { "enum": ["DESCRIBES", "DEPENDS_ON"] },
          "relatedSpdxElement": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
