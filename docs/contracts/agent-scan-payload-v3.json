{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sentari.dev/contracts/agent-scan-payload-v3.json",
  "title": "Sentari agent scan payload v3 — additions",
  "description": "Schema for the 5 v3 array fields (4 from Phase 3, installed_runtimes from Phase 4).",
  "type": "object",
  "properties": {
    "dep_edges": { "type": "array", "items": { "$ref": "#/definitions/DepEdge" } },
    "lockfiles": { "type": "array", "items": { "$ref": "#/definitions/LockfileMeta" } },
    "supply_chain_signals": { "type": "array", "items": { "$ref": "#/definitions/SupplyChainSignal" } },
    "license_evidence": { "type": "array", "items": { "$ref": "#/definitions/LicenseEvidence" } },
    "installed_runtimes": { "type": "array", "items": { "$ref": "#/definitions/InstalledRuntime" } },
    "os_release": { "$ref": "#/definitions/OsRelease" },
    "container_targets": { "type": "array", "items": { "$ref": "#/definitions/ContainerTargetSummary" } },
    "tags": { "type": ["array", "null"], "items": { "type": "string" } },
    "runtime": { "type": "string", "enum": ["bare_metal", "container", "k8s", "unknown"] }
  },
  "definitions": {
    "DepEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent_name", "parent_version", "child_name", "child_version", "ecosystem", "type", "scope", "depth", "introduced_by_path", "resolved"],
      "properties": {
        "parent_name": { "type": "string" },
        "parent_version": { "type": "string" },
        "child_name": { "type": "string" },
        "child_version": { "type": "string" },
        "ecosystem": { "type": "string", "enum": ["pypi", "npm", "maven", "nuget"] },
        "type": { "type": "string", "enum": ["direct", "transitive", "peer", "optional", "dev", "test"] },
        "scope": { "type": "string" },
        "depth": { "type": "integer", "minimum": 0 },
        "introduced_by_path": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
        "resolved": { "type": "boolean" }
      }
    },
    "LockfileMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "format", "ecosystem", "sha256", "last_modified", "declared_packages_count", "drift_status"],
      "properties": {
        "path": { "type": "string" },
        "format": { "type": "string", "enum": ["package_lock_v2", "package_lock_v3", "yarn_v1", "yarn_berry", "pnpm_lock", "pom_xml", "packages_lock_json", "project_assets_json", "poetry_lock", "uv_lock", "pipfile_lock", "requirements_txt"] },
        "ecosystem": { "type": "string", "enum": ["pypi", "npm", "maven", "nuget"] },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "last_modified": { "type": "string", "format": "date-time" },
        "declared_packages_count": { "type": "integer", "minimum": 0 },
        "drift_status": { "type": "string", "enum": ["in_sync", "drift_detected", "unknown"] }
      }
    },
    "SupplyChainSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_name", "package_version", "ecosystem", "signal_type", "severity", "source"],
      "properties": {
        "package_name": { "type": "string" },
        "package_version": { "type": "string" },
        "ecosystem": { "type": "string", "enum": ["pypi", "npm", "maven", "nuget"] },
        "signal_type": { "type": "string", "enum": ["postinstall_script", "preinstall_script", "install_script", "unsigned", "provenance_attested", "yanked", "deprecated", "maintainer_changed", "typosquat_suspect", "npm_malware_advisory", "pypi_malware_advisory", "maven_malware_advisory", "nuget_malware_advisory", "maven_checksum_mismatch", "maven_snapshot_in_release", "maven_untrusted_repo"] },
        "severity": { "type": "string", "enum": ["info", "low", "medium", "high", "critical"] },
        "source": { "type": "string" },
        "raw": { "type": "object", "additionalProperties": true }
      }
    },
    "LicenseEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_name", "package_version", "ecosystem", "source", "confidence"],
      "properties": {
        "package_name": { "type": "string" },
        "package_version": { "type": "string" },
        "ecosystem": { "type": "string", "enum": ["pypi", "npm", "maven", "nuget"] },
        "spdx_id": { "type": ["string", "null"] },
        "source": { "type": "string", "enum": ["trove", "spdx_pkg", "pom", "nuspec", "copyright_file", "rpm_header", "server_enriched"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "raw_text": { "type": ["string", "null"] }
      }
    },
    "InstalledRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "cycle", "install_path"],
      "properties": {
        "name": { "type": "string", "enum": ["python", "node", "jdk", "wildfly", "jboss-eap", "tomcat", "jetty", "payara", "glassfish", "weblogic", "websphere", "nginx", "apache-httpd", "iis", "rabbitmq", "kafka", "activemq", "activemq-artemis"] },
        "version": { "type": "string" },
        "cycle": { "type": "string" },
        "distro": { "type": ["string", "null"] },
        "install_path": { "type": "string" }
      }
    },
    "OsRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version_id"],
      "properties": {
        "id": { "type": "string" },
        "version_id": { "type": "string" },
        "kernel": { "type": "string" }
      }
    },
    "ContainerTargetSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "image_id", "layer_count"],
      "properties": {
        "runtime": { "type": "string" },
        "image_id": { "type": "string" },
        "image_tags": { "type": "array", "items": { "type": "string" } },
        "container_id": { "type": "string" },
        "container_name": { "type": "string" },
        "layer_count": { "type": "integer" },
        "layer_digests": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
